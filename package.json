{
  "name": "pdfluent",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "version": "1.0.0-beta.21",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:verified": "bash scripts/build-verified.sh",
    "verify:embed": "node scripts/verify-frontend-embed.mjs",
    "release:windows": "bash scripts/release-windows-remote.sh",
    "publish:release": "bash scripts/publish-release.sh",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test tests/e2e/smoke-shell.spec.ts",
    "test:native-smoke": "cargo test --manifest-path src-tauri/Cargo.toml --lib op_render_page_and_thumbnail_produce_image_bytes && playwright test tests/e2e/smoke-shell.spec.ts",
    "typecheck": "tsc --noEmit",
    "ocr:manifest": "node scripts/generate-ocr-model-manifest.mjs",
    "compliance:generate": "node scripts/generate-third-party.mjs",
    "compliance:check": "node scripts/check-licenses.mjs",
    "compliance": "npm run compliance:generate && npm run compliance:check"
  },
  "dependencies": {
    "@libpdf/core": "^0.2.10",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "i18next": "^25.8.18",
    "jszip": "^3.10.1",
    "lucide-react": "^0.522.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
