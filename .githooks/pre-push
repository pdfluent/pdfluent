# A push to release/editor-next needs a full pass of the fast gates on exactly
# the tree being pushed (scripts/ci/run-fast-gates-locally.sh), because a red
# gate skips every Linux job behind it and costs the round.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/release/editor-next" ]; then
    exec "$(git rev-parse --show-toplevel)/scripts/ci/run-fast-gates-locally.sh" --verify
  fi
done
exit 0
