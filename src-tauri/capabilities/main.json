{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window capability for PDFluent desktop workflows.",
  "windows": [
    "main",
    "main-recovery"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-print",
    "core:window:allow-set-title",
    "dialog:default",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-copy-file",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "/**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    }
  ]
}
