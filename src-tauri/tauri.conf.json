{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-schema/main/schema.json",
  "productName": "PDFluent",
  "version": "1.0.0-beta.21",
  "identifier": "com.pdfluent.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420/",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PDFluent",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "updater",
          "description": "Self-updater + relaunch. Defined INLINE (not a capabilities/ file) so the Mac App Store build can drop it via a config override (app.security.capabilities = [\"main\"]) without the build script validating the updater permission that is compiled out there.",
          "windows": [
            "main",
            "main-recovery"
          ],
          "permissions": [
            "updater:default",
            "process:default"
          ]
        }
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 http://127.0.0.1:1420 ws://127.0.0.1:1420 https://report.pdfluent.com; worker-src 'self' blob:; frame-src 'self' asset: http://asset.localhost blob: data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "/**",
          "$HOME/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$RESOURCE/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "scripts/paddle_ocr_bridge.py": "scripts/paddle_ocr_bridge.py",
      "scripts/requirements-ocr.txt": "scripts/requirements-ocr.txt",
      "resources/bin": "resources/bin",
      "resources/fonts/liberation-2.1.5": "resources/fonts/liberation-2.1.5",
      "../LICENSE.md": "legal/LICENSE.md",
      "../THIRD_PARTY.md": "legal/THIRD_PARTY.md",
      "../THIRD_PARTY_ATTRIBUTIONS.md": "legal/THIRD_PARTY_ATTRIBUTIONS.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "Developer ID Application: Innovation Trigger B.V. (58Z6SVW7CN)",
      "frameworks": []
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "office",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "category": "public.app-category.productivity",
    "shortDescription": "Fast, private PDF editor",
    "longDescription": "PDFluent is a privacy-first desktop PDF editor. View, annotate, fill forms, merge, split, sign, and convert PDFs \u2014 all processed locally on your device.",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true,
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          ".\\scripts\\sign-windows.ps1",
          "%1"
        ]
      },
      "wix": {
        "bannerPath": "wix/banner.bmp",
        "dialogImagePath": "wix/dialog.bmp"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf"
      }
    ]
  },
  "plugins": {
    "dialog": null,
    "updater": {
      "endpoints": [
        "https://pdfluent.com/releases/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMkJBRDlBQUJGOTk1REQKUldUZGxmbXJtcTBybnZXaGlDUmpJYmc4ZThSZnZvQ0h6YnNpRUVuNGV3bGUrRjFNRmpMcXFOYk4K"
    }
  }
}
