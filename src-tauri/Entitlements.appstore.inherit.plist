<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Nested-helper entitlements for the Mac App Store build. Every executable
      bundled under the .app (e.g. resources/bin/pdfluent_translate_helper) must
      be signed for the sandbox. `inherit` makes the helper run inside the parent
      app's sandbox container rather than declaring its own entitlements — the
      required pattern for sandboxed helper tools spawned by the main app.

      The bundled Tesseract (Resources/resources/ocr/bin/tesseract) is such a
      helper. It takes the page as PNG on stdin and answers on stdout, reads its
      language data from the signed bundle and writes no file, so inheriting the
      sandbox is all it needs; its container temp folder is writable if it ever
      does. scripts/mas-entitlements.mjs (helpers mode) reads this signature back.
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
